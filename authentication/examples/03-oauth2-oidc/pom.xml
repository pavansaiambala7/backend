<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.backend.auth</groupId>
    <artifactId>oauth2-oidc</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>03-oauth2-oidc</name>
    <description>OAuth 2.0 + OpenID Connect: authorization server, resource server and BFF client app</description>

    <modules>
        <module>authorization-server</module>
        <module>resource-server</module>
        <module>client-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Boot does not manage Bouncy Castle; 1.85 is the version Spring Security 7.1.1 builds against. -->
        <bouncycastle.version>1.85</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Required by Spring Security's Argon2PasswordEncoder (authorization server only). -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
